{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zumhermann-webseite",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "logpush": false,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "zumhermann.de",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
