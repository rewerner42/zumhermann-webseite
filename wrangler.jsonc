{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zumhermann-webseite",
  "account_id": "0db45adad30041a8fb85829450807027",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "logpush": false,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "zumhermann.de",
      "custom_domain": true
    },
    {
      "pattern": "www.zumhermann.de/*",
      "zone_name": "zumhermann.de"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
